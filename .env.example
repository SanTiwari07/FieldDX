# Copy to .env. Every setting is optional; see the Configuration section of README.md.

# Gemini writes the plain-language case file. Without a key, a template narrative is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# FIELDDX_LLM=off

# Earth Engine: run `earthengine authenticate` once. Set a cloud project if your account needs one.
# FIELDDX_EE_PROJECT=

# The Fields of the World CLI, for running the field model on fresh imagery
# FIELDDX_FTW=

# Pause between investigation steps, in milliseconds
# DEMO_PACING=550
